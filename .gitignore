# Local config / runtime
.happy-photo-organizer/
*.log
# ...but not a drill's own logs: the #28 lock refuses a receipt whose
# drill_log is not in the repo (UPDATE_DRILL §5 step 6)
!drills/logs/*.log
release-notes-*.md

# Sensitive
auth.json
*.env
# The built-in Gemini key lives OUTSIDE the repo, in
# %USERPROFILE%\.embed-keys\Happy-Photo-Organizer.json (house rule KEY_EMBED;
# core/keymask.py). These stay ignored only as a backstop: secrets/ was the
# retired first location, and gemini.key is the masked copy a build bundles.
# tools/key_guard.py (pre-commit + commit-msg hooks) is the real guard.
secrets/
*.key

# Claude Code session state
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Backups
*.zip
*.bak
